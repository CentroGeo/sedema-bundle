# Entorno de desarrollo local para sedema (frontends fuera de Docker)
# Requiere: 127.0.0.1 sedema.localhost en /etc/hosts
hostname=sedema.localhost
env_type=dev
oidc_provider_url=http://sedema.localhost/iam/realms/sedema
https_mode=http

# Módulos del frontend. Estas claves se copian al .env del bundle y de ahí las
# lee tanto el contenedor Nuxt como scripts/dev-frontend.sh. Un módulo con su
# flag en false devuelve 404 (middleware habilitar_modulos.global.ts).
NUXT_PUBLIC_ENABLE_GEOCONTENIDOS=true
NUXT_PUBLIC_ENABLE_PANORAMAS=true
# Visores públicos independientes (/geohistorias y /tableros):
# NUXT_PUBLIC_ENABLE_GEOHISTORIAS=true
# NUXT_PUBLIC_ENABLE_TABLEROS=true
# Constructor de páginas (/landing-builder):
# NUXT_PUBLIC_ENABLE_LANDING_BUILDER=true
