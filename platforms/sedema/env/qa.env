# QA environment overrides for sedema
hostname=sedema-qa.geosuitemp.centrogeo.org.mx
env_type=test
oidc_provider_url=https://sedema-qa.geosuitemp.centrogeo.org.mx/iam/realms/sedema
https_mode=externalhttps

# Módulos habilitados en el frontend público
NUXT_PUBLIC_ENABLE_AUTH=true
NUXT_PUBLIC_ENABLE_CATALOGO_VISTA=true
NUXT_PUBLIC_ENABLE_CATALOGO_CARGA=true
NUXT_PUBLIC_ENABLE_CONSULTA=true
NUXT_PUBLIC_ENABLE_LEVANTAMIENTO=true
NUXT_PUBLIC_ENABLE_GEOCONTENIDOS=true
NUXT_PUBLIC_ENABLE_GEOHISTORIAS=true
NUXT_PUBLIC_ENABLE_MAPAS=true
NUXT_PUBLIC_ENABLE_TABLEROS=true
NUXT_PUBLIC_ENABLE_PANORAMAS=true
NUXT_PUBLIC_ENABLE_ACERCA_DE=false
NUXT_PUBLIC_ENABLE_IAA=false
NUXT_PUBLIC_ENABLE_LANDING_BUILDER=false

# URL interna de Keycloak para fetch de JWKS desde Django (evita salir por la URL pública
# que no es alcanzable desde dentro de la red Docker)
KEYCLOAK_JWKS_URL=http://keycloak:8080/iam/realms/sedema/protocol/openid-connect/certs
